<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clarified Horizon – Translate</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --teal:       #1b6b6e;
      --teal-dark:  #124b4d;
      --teal-light: #2a9ea3;
      --teal-pale:  #e6f4f4;
      --teal-mid:   #c2e4e4;
      --gold:       #c9a84c;
      --gold-light: #e8c97e;
      --cream:      #f9f5ef;
      --white:      #ffffff;
      --off-white:  #f5f7f7;
      --gray-100:   #f1f3f3;
      --gray-200:   #e4e8e8;
      --gray-300:   #cdd3d3;
      --gray-400:   #96a3a4;
      --gray-600:   #556162;
      --gray-700:   #3a4f50;
      --dark:       #182020;
      --green:      #2e9b6a;
      --green-pale: #e6f7ef;
      --font-display: 'Playfair Display', Georgia, serif;
      --font-body:    'DM Sans', sans-serif;
      --shadow-sm:  0 2px 8px rgba(14,28,29,.07);
      --shadow-md:  0 6px 24px rgba(14,28,29,.11);
      --shadow-lg:  0 16px 48px rgba(14,28,29,.15);
      --radius:     14px;
      --radius-lg:  20px;
      --t:          .25s cubic-bezier(.4,0,.2,1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      background: var(--off-white);
      color: var(--dark);
      font-size: 15px;
      line-height: 1.65;
      overflow-x: hidden;
    }

    /* ── NAV ── */
    nav {
      background: var(--white);
      border-bottom: 1.5px solid var(--gray-200);
      position: sticky; top: 0; z-index: 100;
    }
    .nav-inner {
      max-width: 1160px; margin: 0 auto; padding: 0 28px;
      display: flex; align-items: center; justify-content: space-between; height: 64px;
    }
    .logo {
      font-family: var(--font-display); font-size: 20px; font-weight: 700;
      color: var(--teal-dark); text-decoration: none; letter-spacing: -.3px;
    }
    .nav-links { display: flex; gap: 4px; list-style: none; }
    .nav-links a {
      text-decoration: none; color: var(--gray-600);
      font-size: 13px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
      padding: 7px 16px; border-radius: 6px;
      transition: background var(--t), color var(--t);
    }
    .nav-links a:hover { background: var(--teal-pale); color: var(--teal); }
    .nav-links a.active {
      color: var(--teal);
      border-bottom: 2.5px solid var(--teal);
      border-radius: 0;
    }
    .nav-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: linear-gradient(135deg, var(--teal-light), var(--teal-dark));
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; font-weight: 700; color: var(--white);
      cursor: pointer; border: 2px solid var(--gray-200);
      transition: border-color var(--t), box-shadow var(--t);
    }
    .nav-avatar:hover { border-color: var(--teal-light); box-shadow: 0 0 0 3px var(--teal-pale); }

    /* ── LAYOUT ── */
    .wrap { max-width: 1160px; margin: 0 auto; padding: 0 28px 72px; }

    /* ── HERO BANNER ── */
    .hero-banner {
      border-radius: var(--radius-lg);
      margin: 28px 0 36px;
      padding: 52px 56px;
      background: linear-gradient(130deg, #0e3a3c 0%, var(--teal) 50%, #2fb8be 100%);
      position: relative; overflow: hidden;
      min-height: 120px; display: flex; align-items: center;
    }
    .hero-banner .wave-bg {
      position: absolute; right: 0; top: 0; bottom: 0;
      width: 56%; pointer-events: none;
    }
    .hero-banner .wave-bg svg { width: 100%; height: 100%; }
    .hero-content { position: relative; z-index: 2; }
    .hero-banner h1 {
      font-family: var(--font-display); font-size: clamp(24px, 3vw, 36px);
      font-weight: 900; color: var(--white); line-height: 1.1;
      margin-bottom: 5px;
    }
    
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 26px; border-radius: 50px;
      font-family: var(--font-body); font-size: 14px; font-weight: 600;
      cursor: pointer; border: 2px solid transparent;
      transition: all var(--t); text-decoration: none;
    }
    .btn-teal { background: var(--teal); color: var(--white); border: none; }
    .btn-teal:hover { background: var(--teal-dark); transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .btn-dark { background: var(--dark); color: var(--white); border: none; }
    .btn-dark:hover { background: #2c3c3d; transform: translateY(-2px); box-shadow: var(--shadow-md); }

    /* TRANSLATE CONTAINER */
    .translate-container {
      background: var(--white);
      border: 1.5px solid var(--gray-200);
      border-radius: var(--radius-lg);
      padding: 40px;
      margin-top: 10px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    
    .top-controls {
        display: flex;
        justify-content: space-between;
        width: 100%;
        max-width: 800px;
        margin-bottom: 20px;
        align-items: center;
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      max-width: 800px;
      background: #000;
      border-radius: 14px;
      overflow: hidden;
      aspect-ratio: 4/3;
      box-shadow: inset 0 2px 10px rgba(0,0,0,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .video-wrapper p {
        color: #fff;
        font-weight: 600;
        font-size: 16px;
    }
    
    .video-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }

    .translation-box {
      margin-top: 30px;
      font-family: var(--font-display);
      font-size: 64px;
      font-weight: 900;
      color: var(--teal);
      min-height: 80px;
      text-align: center;
      line-height: 1;
    }

    .translation-label {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--gray-400);
      margin-top: 10px;
    }

    #hidden-video, #hidden-canvas {
      position: absolute;
      opacity: 0;
      pointer-events: none;
      width: 1px;
      height: 1px;
    }

    .status-badge {
      padding: 6px 14px;
      border-radius: 20px;
      background: var(--gray-200);
      font-size: 12px;
      font-weight: 700;
      color: var(--gray-600);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .status-badge.connected {
      background: var(--green-pale);
      color: var(--green);
    }
    
    /* ── FOOTER ── */
    footer { background: var(--dark); color: rgba(255,255,255,.38); padding: 34px 0; margin-top: 60px; }
    .footer-inner {
      max-width: 1160px; margin: 0 auto; padding: 0 28px;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;
    }
    .f-logo { font-family: var(--font-display); font-size: 18px; font-weight: 700; color: var(--white); }
    .f-sub { font-size: 12px; margin-top: 2px; }
    .f-links { display: flex; gap: 22px; list-style: none; flex-wrap: wrap; }
    .f-links a { color: rgba(255,255,255,.38); text-decoration: none; font-size: 12.5px; transition: color .2s; }
    .f-links a:hover { color: var(--white); }
  </style>
</head>
<body>

<!-- ── NAVBAR ── -->
<nav>
  <div class="nav-inner">
    <a href="/" class="logo">Clarified Horizon</a>
    <ul class="nav-links">
      <li><a href="/">HOME</a></li>
      <li><a href="/learn">LEARN</a></li>
      <li><a href="/translate" class="active">TRANSLATE</a></li>
    </ul>
    <div class="nav-avatar" title="Sarah">S</div>
  </div>
</nav>

<!-- ── PAGE ── -->
<div class="wrap">
  <!-- Hero -->
  <div class="hero-banner">
    <div class="wave-bg">
      <svg viewBox="0 0 600 220" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,80 C80,20 160,140 240,80 C320,20 400,130 480,80 C540,44 580,90 600,70 L600,0 L0,0 Z" fill="rgba(255,255,255,0.055)"/>
        <path d="M0,140 C90,80 180,200 270,140 C360,80 450,190 600,140 L600,220 L0,220 Z" fill="rgba(255,255,255,0.045)"/>
        <path d="M0,180 C100,130 200,210 300,170 C400,130 500,200 600,160 L600,220 L0,220 Z" fill="rgba(255,255,255,0.03)"/>
      </svg>
    </div>
    <div class="hero-content">
      <h1>Real-Time Translator</h1>
      <p style="color: rgba(255,255,255,0.8); font-size: 16px;">Instantly convert your signs to text using our advanced AI.</p>
    </div>
  </div>

  <!-- Translation Container -->
  <div class="translate-container">
    
    <div class="top-controls">
        <button id="camera-btn" class="btn btn-teal" onclick="toggleCamera()">
            <span id="camera-icon">📷</span> <span id="camera-text">Start Camera</span>
        </button>
        <div id="status" class="status-badge">Disconnected</div>
    </div>
    
    <div class="video-wrapper" id="video-wrapper">
        <p id="placeholder-text">Camera is currently off. Click 'Start Camera' to begin translating.</p>
        <img id="output-image" src="" alt="Live ASL Feed" />
    </div>
    
    <div class="translation-box" id="translation-text">...</div>
    <div class="translation-label">Current Sign</div>
    
  </div>
  
  <video id="hidden-video" autoplay playsinline></video>
  <canvas id="hidden-canvas"></canvas>
</div>

<!-- ── FOOTER ── -->
<footer>
  <div class="footer-inner">
    <div>
      <div class="f-logo">Clarified Horizon</div>
      <div class="f-sub">© 2024 Clarified Horizon. Clarity in every sign.</div>
    </div>
    <ul class="f-links">
      <li><a href="#">Terms of Service</a></li>
      <li><a href="#">Privacy Policy</a></li>
      <li><a href="#">Support Center</a></li>
    </ul>
  </div>
</footer>

<script>
    const video = document.getElementById('hidden-video');
    const canvas = document.getElementById('hidden-canvas');
    const ctx = canvas.getContext('2d');
    const outputImage = document.getElementById('output-image');
    const transText = document.getElementById('translation-text');
    const statusBadge = document.getElementById('status');
    const cameraBtn = document.getElementById('camera-btn');
    const cameraText = document.getElementById('camera-text');
    const placeholderText = document.getElementById('placeholder-text');
    
    let ws;
    let cameraStream = null;
    let isTranslating = false;
    let intervalId = null;
    let lastSpokenTranslation = "";
    let speechMsg = null; // Store globally to prevent garbage collection bug in some browsers
    let isWaitingForFrame = false;

    function speakTranslation(text) {
        if ('speechSynthesis' in window) {
            console.log("Speaking translation:", text);
            window.speechSynthesis.cancel(); // Stop current speech
            
            speechMsg = new SpeechSynthesisUtterance(text);
            speechMsg.lang = 'en-US';
            speechMsg.rate = 1.0; 
            speechMsg.volume = 1.0;
            
            // Short delay ensures engine resets properly after cancel()
            setTimeout(() => {
                window.speechSynthesis.speak(speechMsg);
            }, 50);
        }
    }

    function toggleCamera() {
        if (isTranslating) {
            stopCamera();
        } else {
            startCamera();
        }
    }

    function startCamera() {
        navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => {
                cameraStream = stream;
                video.srcObject = stream;
                video.play().catch(e => console.error("Video play error:", e));
                isTranslating = true;
                cameraText.innerText = "Stop Camera";
                cameraBtn.className = "btn btn-dark";
                placeholderText.style.display = "none";
                outputImage.style.display = "block";
                connectWebSocket();
            })
            .catch(err => {
                console.error("Camera error:", err);
                alert("Camera error: " + err.name + " - " + err.message + "\nAre you accessing via localhost?");
            });
    }
    
    function stopCamera() {
        if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
        }
        if (ws) {
            ws.close();
        }
        if (intervalId) {
            clearInterval(intervalId);
        }
        isTranslating = false;
        cameraText.innerText = "Start Camera";
        cameraBtn.className = "btn btn-teal";
        placeholderText.style.display = "block";
        outputImage.style.display = "none";
        statusBadge.className = "status-badge";
        statusBadge.innerText = "Disconnected";
        transText.innerText = "...";
    }

    function connectWebSocket() {
        // Connect to Python WebSocket Server running on port 8000
        ws = new WebSocket('ws://localhost:8000/ws/translate');
        
        ws.onopen = () => {
            if(!isTranslating) {
                ws.close();
                return;
            }
            statusBadge.className = "status-badge connected";
            statusBadge.innerText = "Connected to AI";
            // Check frequently, but only send if not waiting on server response (Ping-pong)
            intervalId = setInterval(sendFrame, 35); 
        };
        
        ws.onmessage = (event) => {
            isWaitingForFrame = false; // Server finished processing previous frame
            const data = JSON.parse(event.data);
            if(data.image) {
                outputImage.src = "data:image/jpeg;base64," + data.image;
            }
            if(data.translation && data.translation !== "?") {
                transText.innerText = data.translation;
                
                // Speak if it's a new translation we haven't just spoken
                if (lastSpokenTranslation !== data.translation) {
                    speakTranslation(data.translation);
                    lastSpokenTranslation = data.translation;
                }
            } else if (data.skeleton_found) {
                transText.innerText = "Recognizing...";
                lastSpokenTranslation = ""; // Reset when returning to recognizing so same letter can be re-spoken
            } else {
                transText.innerText = "No hand detected";
                lastSpokenTranslation = ""; // Reset so the same sign can be spoken again later
            }
        };
        
        ws.onclose = () => {
            if (intervalId) clearInterval(intervalId);
            if(isTranslating) {
                statusBadge.className = "status-badge";
                statusBadge.innerText = "Reconnecting...";
                setTimeout(connectWebSocket, 3000); // Reconnect
            }
        };
    }

    function sendFrame() {
        if(ws && ws.readyState === WebSocket.OPEN && video.readyState === video.HAVE_ENOUGH_DATA && !isWaitingForFrame) {
            isWaitingForFrame = true; // Lock down until server replies
            
            // Limit resolution max to ~640x480 for much lower network/AI latency
            const maxW = 640;
            const maxH = 480;
            
            let w = video.videoWidth;
            let h = video.videoHeight;
            
            if (w > maxW) {
                h = Math.round(h * (maxW / w));
                w = maxW;
            }
            if (h > maxH) {
                w = Math.round(w * (maxH / h));
                h = maxH;
            }
            
            canvas.width = w;
            canvas.height = h;
            ctx.drawImage(video, 0, 0, w, h);
            
            // Get JPEG base64 (0.6 quality keeps it tiny)
            const dataUrl = canvas.toDataURL('image/jpeg', 0.6); 
            ws.send(dataUrl);
        }
    }
</script>
</body>
</html>
