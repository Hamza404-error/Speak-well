<script>
  document.addEventListener('DOMContentLoaded', () => {
    const userName = localStorage.getItem('userName');
    if (userName) {
      const firstLetter = userName.charAt(0).toUpperCase();
      const navActions = document.querySelector('.nav-actions');
      if (navActions) {
        navActions.innerHTML = '<div class="nav-avatar" title="Logged in as ' + userName + ' (Click to Log Out / Dashboard)" onclick="if(confirm(\'Do you want to log out? (Cancel to go to Dashboard)\')) { localStorage.removeItem(\'userName\'); window.location.reload(); } else { window.location.href=\'/learn\'; }">' + firstLetter + '</div>';
      }
    }
  });
</script>

