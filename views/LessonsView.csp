        </div>
      </div>
    </div>

    <!-- ═══ UNIT 2 ═══ -->
    <div class="unit-card" data-unit="2">
      <div class="unit-header" onclick="toggleUnit(this)">
        <div class="unit-number" style="background:linear-gradient(135deg,#d4a43a,#e8c97e)">2</div>
        <div class="unit-info">
          <h2>Module 2: Numbers &amp; Counting</h2>
          <p>Master ASL numbers 1–100 and learn to count fluently in any conversation.</p>
        </div>
        <div class="unit-meta">
