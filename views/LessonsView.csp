<!-- ── LESSON MODAL ── -->
<div class="modal-overlay" id="lessonModal" onclick="handleOverlayClick(event)">
  <div class="modal" id="modalContent">
    <button class="modal-close" onclick="closeModal()">✕</button>

    <div class="modal-breadcrumb">
      <a href="#">Learn</a> ›
      <a href="#" id="modalBreadUnit">Module 1: Basic Greetings</a> ›
      <span id="modalBreadLesson">Lesson 1: Hello</span>
    </div>
    <h1 class="modal-title" id="modalTitle">Learning the "Hello" Sign</h1>

    <div class="modal-body">
      <!-- Left: video + guide -->
      <div>
        <div>
          <div class="video-area">
            <div class="video-placeholder">
              <button class="play-btn" id="playBtn" onclick="togglePlay()">▶</button>
              <p>Video demonstration loading…</p>
            </div>
          </div>
          <div class="video-controls">
            <button class="ctrl-btn" onclick="togglePlay()" id="ctrlPlayBtn">▶</button>
            <button class="ctrl-btn">↺</button>
            <div class="ctrl-track">
              <div class="ctrl-fill" id="ctrlFill"></div>
            </div>
            <button class="ctrl-btn">⛶</button>
            <button class="ctrl-btn">⤢</button>
          </div>
        </div>

        <div class="tutorial-guide">
          <div class="tg-eyebrow">Tutorial Guide</div>
          <div class="tg-title">Execution &amp; Form</div>
          <div class="steps-grid-modal" id="modalStepsGrid">
            <div class="step-item">
              <div class="step-dot">1</div>
              <div>
                <h4>The Handshape</h4>
                <p>Start with a flat hand, fingers together, and thumb tucked comfortably against the side of your palm.</p>
              </div>
            </div>
            <div class="step-item">
              <div class="step-dot">3</div>
              <div>
                <h4>The Movement</h4>
                <p>Move your hand away from your head in a small, outward arc, similar to a salute.</p>
              </div>
            </div>
            <div class="step-item">
              <div class="step-dot">2</div>
              <div>
                <h4>The Placement</h4>
                <p>Touch the tips of your fingers to your forehead, just above your temple.</p>
              </div>
            </div>
          </div>
          <div class="tip-box">ℹ️ Keep your movement fluid and natural. Don't over-stiffen your wrist!</div>
        </div>
      </div>

      <!-- Right panel -->
      <div class="right-panel">
        <!-- AI Practice -->
        <div class="ai-panel">
          <div class="ai-panel-header">
            <h3>📷 Practice with AI</h3>
            <span class="live-badge">LIVE ANALYSIS</span>
          </div>
          <div class="cam-view">
            <div class="cam-icon">📷</div>
            <div class="cam-badge">Hand Detected</div>
            <div class="cam-hint">"Keep your hand steady"</div>
          </div>
          <div class="accuracy-row">
            <span>Accuracy</span>
            <span class="pct" id="modalAccuracy">84%</span>
          </div>
          <button class="assessment-btn">Start Final Assessment</button>
        </div>

        <!-- Module progress -->
        <div class="module-panel">
          <div class="module-panel-title">Module Progress</div>
          <div class="module-lesson-item active">
            <div class="mod-icon active-icon">▶</div>
            <div class="mod-info">
              <div class="mod-name" id="modalActiveName">1. Hello</div>
              <div class="mod-meta">Currently Learning</div>
            </div>
          </div>
          <div class="mod-divider"></div>
          <div class="module-lesson-item">
            <div class="mod-icon locked-icon">🔒</div>
            <div class="mod-info">
              <div class="mod-name">2. How are you?</div>
              <div class="mod-meta">5 minutes</div>
            </div>
          </div>
          <div class="mod-divider"></div>
          <div class="module-lesson-item">
            <div class="mod-icon locked-icon">🔒</div>
            <div class="mod-info">
              <div class="mod-name">3. My name is…</div>
              <div class="mod-meta">8 minutes</div>
            </div>
          </div>
          <button class="mark-complete-btn" onclick="completeCurrentLesson()">Mark as Complete →</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // ── Toggle unit open/close ──
  function toggleUnit(header) {
    const card = header.closest('.unit-card');
    const badge = card.querySelector('.unit-badge');
    
    // Prevent opening if the unit is explicitly locked
    if (badge && badge.classList.contains('badge-locked')) return;
    
    card.classList.toggle('open');
  }

  // ── Open lesson modal ──
  let currentLessonRow = null;

  function openLesson(row, title, unit, desc, duration, accuracy) {
    if (row.classList.contains('locked')) return;
    currentLessonRow = row;

    // Update modal content
    document.getElementById('modalTitle').textContent = 'Learning the "' + title + '" Sign';
    document.getElementById('modalBreadUnit').textContent = unit;
    document.getElementById('modalBreadLesson').textContent = 'Lesson: ' + title;
    document.getElementById('modalAccuracy').textContent = accuracy;
    document.getElementById('modalActiveName').textContent = title;

    document.getElementById('lessonModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('lessonModal').classList.remove('open');
    document.body.style.overflow = '';
  }

  function handleOverlayClick(e) {
    if (e.target === document.getElementById('lessonModal')) closeModal();
  }

  // Close on Escape
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  // ── Complete current lesson and unlock next ──
  function completeCurrentLesson() {
    if (!currentLessonRow) return;

    // 1. Mark the current lesson as complete visually
    const icon = currentLessonRow.querySelector('.lesson-icon');
    if (icon) {
      icon.className = 'lesson-icon lesson-icon-complete';
      icon.textContent = '✅';
    }
    const statusIcon = currentLessonRow.querySelector('.lesson-status-icon');
    if (statusIcon) statusIcon.textContent = '✅';

    // 2. Find the next lesson in the current unit
    const lessonsList = currentLessonRow.closest('.lessons-list');
    const allLessons = Array.from(lessonsList.querySelectorAll('.lesson-row'));
    const currentIndex = allLessons.indexOf(currentLessonRow);
    const nextLessonRow = allLessons[currentIndex + 1];

    if (nextLessonRow) {
      // Unlock the next lesson
      nextLessonRow.classList.remove('locked');
      const nextIcon = nextLessonRow.querySelector('.lesson-icon');
      if (nextIcon) {
        nextIcon.className = 'lesson-icon lesson-icon-active';
        nextIcon.textContent = '▶️';
      }
      const nextStatusIcon = nextLessonRow.querySelector('.lesson-status-icon');
      if (nextStatusIcon) nextStatusIcon.textContent = '🔵';

      // Attach the onclick handler if it's missing (for hardcoded HTML elements)
      if (!nextLessonRow.hasAttribute('onclick')) {
        const titleElem = nextLessonRow.querySelector('h3');
        const title = titleElem ? titleElem.textContent.replace(/^\d+\.\s*/, '') : 'Next Lesson';
        const unitTitle = currentLessonRow.closest('.unit-card').querySelector('h2').textContent;
        const durationElem = nextLessonRow.querySelector('.lesson-duration');
        const duration = durationElem ? durationElem.textContent : '5 min';
        nextLessonRow.setAttribute('onclick', `openLesson(this, '${title}', '${unitTitle}', '', '${duration}', '0%')`);
      }
    } else {
      // No more lessons in this unit, mark unit complete
      const currentUnit = currentLessonRow.closest('.unit-card');
      const unitBadge = currentUnit.querySelector('.unit-badge');
      if (unitBadge) {
        unitBadge.className = 'unit-badge badge-complete';
        unitBadge.textContent = 'Complete';
      }

      // Find and unlock the next unit
      const nextUnit = currentUnit.nextElementSibling;
      if (nextUnit && nextUnit.classList.contains('unit-card')) {
        const nextUnitBadge = nextUnit.querySelector('.unit-badge');
        if (nextUnitBadge) {
          nextUnitBadge.className = 'unit-badge badge-inprogress';
          nextUnitBadge.textContent = 'In Progress';
        }
        
        nextUnit.classList.add('open'); // Auto-open newly unlocked unit

        // Unlock its first lesson
        const firstNextLesson = nextUnit.querySelector('.lesson-row');
        if (firstNextLesson) {
          firstNextLesson.classList.remove('locked');
          const nextIcon = firstNextLesson.querySelector('.lesson-icon');
          if (nextIcon) {
            nextIcon.className = 'lesson-icon lesson-icon-active';
            nextIcon.textContent = '▶️';
          }
          const nextStatusIcon = firstNextLesson.querySelector('.lesson-status-icon');
          if (nextStatusIcon) nextStatusIcon.textContent = '🔵';

          if (!firstNextLesson.hasAttribute('onclick')) {
            const titleElem = firstNextLesson.querySelector('h3');
            const title = titleElem ? titleElem.textContent.replace(/^\d+\.\s*/, '') : 'Next Lesson';
            const unitTitle = nextUnit.querySelector('h2').textContent;
            const durationElem = firstNextLesson.querySelector('.lesson-duration');
            const duration = durationElem ? durationElem.textContent : '5 min';
            firstNextLesson.setAttribute('onclick', `openLesson(this, '${title}', '${unitTitle}', '', '${duration}', '0%')`);
          }
        }
      }
    }

    updateOverallProgress();
    closeModal();
  }

  function updateOverallProgress() {
    const allLessons = document.querySelectorAll('.lesson-row');
    const completed = document.querySelectorAll('.lesson-icon-complete').length;
    const total = allLessons.length;
    const pct = Math.round((completed / total) * 100);
    
    const fill = document.querySelector('.overall-progress .progress-fill');
    const pctText = document.querySelector('.overall-progress .progress-pct');
    const metaText = document.querySelector('.overall-progress .progress-meta');
    
    if (fill) fill.style.width = pct + '%';
    if (pctText) pctText.textContent = pct + '%';
    if (metaText) metaText.textContent = completed + ' / ' + total + ' lessons complete';

    // Update unit-level mini progress
    if (currentLessonRow) {
      const currentUnit = currentLessonRow.closest('.unit-card');
      const unitLessons = currentUnit.querySelectorAll('.lesson-row');
      const unitCompleted = currentUnit.querySelectorAll('.lesson-icon-complete').length;
      const unitTotal = unitLessons.length;
      const unitPct = Math.round((unitCompleted / unitTotal) * 100);
      
      const miniFill = currentUnit.querySelector('.mini-fill');
      const miniLabel = currentUnit.querySelector('.mini-label');
      if (miniFill) miniFill.style.width = unitPct + '%';
      if (miniLabel) miniLabel.textContent = unitCompleted + ' / ' + unitTotal + ' complete';
    }
  }

  // ── Fake play button ──
  let playing = false;
  let progress = 40;
  let ticker;
  function togglePlay() {
    playing = !playing;
    document.getElementById('playBtn').textContent = playing ? '⏸' : '▶';
    document.getElementById('ctrlPlayBtn').textContent = playing ? '⏸' : '▶';
    if (playing) {
      ticker = setInterval(() => {
        progress = Math.min(progress + .3, 100);
        document.getElementById('ctrlFill').style.width = progress + '%';
        if (progress >= 100) { clearInterval(ticker); playing = false; document.getElementById('playBtn').textContent = '▶'; document.getElementById('ctrlPlayBtn').textContent = '▶'; progress = 0; }
      }, 100);
    } else { clearInterval(ticker); }
  }

    // ── Show Avatar if Logged In ──
    document.addEventListener('DOMContentLoaded', () => {
      const userName = localStorage.getItem('userName');
      if (userName) {
        const firstLetter = userName.charAt(0).toUpperCase();
        const navIcons = document.querySelector('.nav-icons');
        if (navIcons) {
          const avatarHtml = `<div class="nav-avatar" title="Logged in as ${userName} (Click to log out)" onclick="if(confirm('Do you want to log out?')) { localStorage.removeItem('userName'); window.location.href='/'; }">${firstLetter}</div>`;
          navIcons.insertAdjacentHTML('beforeend', avatarHtml);
        }
      }
    });
</script>
</body>
</html>
