<script>
  // Animate challenge bar on load
  window.addEventListener('load', () => {
    setTimeout(() => { document.getElementById('cFill').style.width = '60%'; }, 400);
  });

  function startChallenge() {
    const btn = document.querySelector('.btn-challenge');
    btn.textContent = '🔥 Challenge started!';
    btn.style.background = '#e8f8f8';
    setTimeout(() => { btn.textContent = 'Start Challenge'; btn.style.background = ''; }, 2000);
  }
</script>

