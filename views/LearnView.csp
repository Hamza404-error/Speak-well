<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clarified Horizon – Learning Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --teal:       #1b6b6e;
      --teal-dark:  #124b4d;
      --teal-light: #2a9ea3;
      --teal-pale:  #e6f4f4;
      --teal-mid:   #c2e4e4;
      --gold:       #c9a84c;
      --gold-light: #e8c97e;
      --cream:      #f9f5ef;
      --white:      #ffffff;
      --off-white:  #f5f7f7;
      --gray-100:   #f1f3f3;
      --gray-200:   #e4e8e8;
      --gray-300:   #cdd3d3;
      --gray-400:   #96a3a4;
      --gray-600:   #556162;
      --gray-700:   #3a4f50;
      --dark:       #182020;
      --green:      #2e9b6a;
      --green-pale: #e6f7ef;
      --font-display: 'Playfair Display', Georgia, serif;
      --font-body:    'DM Sans', sans-serif;
      --shadow-sm:  0 2px 8px rgba(14,28,29,.07);
      --shadow-md:  0 6px 24px rgba(14,28,29,.11);
      --shadow-lg:  0 16px 48px rgba(14,28,29,.15);
      --radius:     14px;
      --radius-lg:  20px;
      --t:          .25s cubic-bezier(.4,0,.2,1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      background: var(--off-white);
      color: var(--dark);
      font-size: 15px;
      line-height: 1.65;
      overflow-x: hidden;
    }

    /* ── NAV ── */
    nav {
      background: var(--white);
      border-bottom: 1.5px solid var(--gray-200);
      position: sticky; top: 0; z-index: 100;
    }
    .nav-inner {
      max-width: 1160px; margin: 0 auto; padding: 0 28px;
      display: flex; align-items: center; justify-content: space-between; height: 64px;
    }
    .logo {
      font-family: var(--font-display); font-size: 20px; font-weight: 700;
      color: var(--teal-dark); text-decoration: none; letter-spacing: -.3px;
    }
    .nav-links { display: flex; gap: 4px; list-style: none; }
    .nav-links a {
      text-decoration: none; color: var(--gray-600);
      font-size: 13px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
      padding: 7px 16px; border-radius: 6px;
      transition: background var(--t), color var(--t);
    }
    .nav-links a:hover { background: var(--teal-pale); color: var(--teal); }
    .nav-links a.active {
      color: var(--teal);
      border-bottom: 2.5px solid var(--teal);
      border-radius: 0;
    }
    .nav-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: linear-gradient(135deg, var(--teal-light), var(--teal-dark));
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; font-weight: 700; color: var(--white);
      cursor: pointer; border: 2px solid var(--gray-200);
      transition: border-color var(--t), box-shadow var(--t);
    }
    .nav-avatar:hover { border-color: var(--teal-light); box-shadow: 0 0 0 3px var(--teal-pale); }

    /* ── LAYOUT ── */
    .wrap { max-width: 1160px; margin: 0 auto; padding: 0 28px 72px; }

    /* ── HERO BANNER ── */
    .hero-banner {
      border-radius: var(--radius-lg);
      margin: 28px 0 36px;
      padding: 52px 56px;
      background: linear-gradient(130deg, #0e3a3c 0%, var(--teal) 50%, #2fb8be 100%);
      position: relative; overflow: hidden;
      min-height: 220px; display: flex; align-items: center;
    }
    .hero-banner .wave-bg {
      position: absolute; right: 0; top: 0; bottom: 0;
      width: 56%; pointer-events: none;
    }
    .hero-banner .wave-bg svg { width: 100%; height: 100%; }
    .hero-content { position: relative; z-index: 2; }
    .hero-eyebrow {
      font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase;
      color: rgba(255,255,255,.6); margin-bottom: 14px;
    }
    .hero-banner h1 {
      font-family: var(--font-display); font-size: clamp(28px, 4vw, 44px);
      font-weight: 900; color: var(--white); line-height: 1.1;
      margin-bottom: 28px;
    }
    .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 26px; border-radius: 50px;
      font-family: var(--font-body); font-size: 14px; font-weight: 600;
      cursor: pointer; border: 2px solid transparent;
      transition: all var(--t); text-decoration: none;
    }
    .btn-dark { background: var(--dark); color: var(--white); }
    .btn-dark:hover { background: #2c3c3d; transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .btn-ghost-white { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.45); color: var(--white); }
    .btn-ghost-white:hover { background: rgba(255,255,255,.22); transform: translateY(-2px); }
    .btn-teal { background: var(--teal); color: var(--white); border: none; }
    .btn-teal:hover { background: var(--teal-dark); transform: translateY(-2px); box-shadow: var(--shadow-md); }

    /* ── MAIN GRID ── */
    .main-grid {
      display: grid;
      grid-template-columns: 1fr 312px;
      gap: 28px;
      align-items: start;
    }

    /* ── SECTION HEADER ── */
    .sec-hd {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 16px;
    }
    .sec-hd h2 {
      font-family: var(--font-display); font-size: 22px; font-weight: 700;
    }
    .sec-link {
      font-size: 13px; font-weight: 600; color: var(--teal); text-decoration: none;
      transition: opacity var(--t);
    }
    .sec-link:hover { opacity: .7; }

    /* ── ACTIVE CARD ── */
    .active-card {
      background: var(--white); border: 1.5px solid var(--gray-200);
      border-radius: var(--radius); padding: 20px;
      display: flex; gap: 18px; align-items: flex-start;
      box-shadow: var(--shadow-sm);
      text-decoration: none; color: inherit;
      transition: box-shadow var(--t), transform var(--t);
    }
    .active-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .active-thumb {
      width: 140px; height: 104px; border-radius: 10px; flex-shrink: 0;
      background: linear-gradient(140deg, #0e2c2e 0%, #1a5254 100%);
      display: flex; align-items: center; justify-content: center;
    }
    .play-circle {
      width: 42px; height: 42px; border-radius: 50%;
      background: rgba(255,255,255,.18); border: 2px solid rgba(255,255,255,.5);
      display: flex; align-items: center; justify-content: center;
      font-size: 15px; color: var(--white);
      transition: background var(--t);
    }
    .active-card:hover .play-circle { background: rgba(255,255,255,.3); }
    .active-info { flex: 1; }
    .active-status {
      font-size: 10.5px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase;
      color: var(--teal); margin-bottom: 5px;
    }
    .active-info h3 { font-size: 17px; font-weight: 700; margin-bottom: 4px; }
    .lesson-sub { font-size: 13px; color: var(--gray-600); margin-bottom: 14px; }
    .prog-row { display: flex; align-items: center; gap: 10px; }
    .prog-label { font-size: 12.5px; color: var(--gray-600); flex-shrink: 0; }
    .prog-track { flex: 1; height: 6px; background: var(--gray-200); border-radius: 99px; overflow: hidden; }
    .prog-fill { height: 100%; background: linear-gradient(90deg, var(--teal-light), var(--teal)); border-radius: 99px; transition: width .6s ease; }
    .prog-pct { font-size: 13px; font-weight: 700; color: var(--teal); flex-shrink: 0; }

    /* ── PATHWAYS ── */
    .pathways { margin-top: 32px; }
    .group-label {
      font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
      color: var(--gray-400); padding-bottom: 10px;
      border-bottom: 1.5px solid var(--gray-200); margin-bottom: 14px;
    }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 26px; }
    .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
    .pathway-card {
      background: var(--white); border: 1.5px solid var(--gray-200);
      border-radius: var(--radius); padding: 20px;
      text-decoration: none; color: inherit; display: block;
      transition: box-shadow var(--t), border-color var(--t), transform var(--t);
    }
    .pathway-card:hover { box-shadow: var(--shadow-md); border-color: var(--teal-mid); transform: translateY(-3px); }
    .card-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px; }
    .p-icon {
      width: 44px; height: 44px; border-radius: 12px; background: var(--teal-pale);
      display: flex; align-items: center; justify-content: center; font-size: 20px;
    }
    .p-meta {
      font-size: 10px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase;
      color: var(--gray-400); background: var(--gray-100); padding: 3px 10px; border-radius: 20px;
      white-space: nowrap; margin-top: 2px;
    }
    .pathway-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 6px; }
    .pathway-card p { font-size: 12.5px; color: var(--gray-600); line-height: 1.55; }

    /* ── RIGHT COLUMN ── */
    .right-col { display: flex; flex-direction: column; gap: 18px; }

    /* Daily Challenge */
    .daily-card {
      background: linear-gradient(135deg, #0e3a3c 0%, var(--teal) 100%);
      border-radius: var(--radius); padding: 24px;
      color: var(--white); position: relative; overflow: hidden;
    }
    .daily-card::before {
      content: '⚡'; position: absolute; right: 16px; top: -4px;
      font-size: 72px; opacity: .09; pointer-events: none;
    }
    .daily-eyebrow {
      font-size: 10.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
      color: rgba(255,255,255,.6); margin-bottom: 8px;
    }
    .daily-card h3 {
      font-family: var(--font-display); font-size: 20px; font-weight: 700;
      margin-bottom: 8px; line-height: 1.2;
    }
    .daily-card p { font-size: 13px; color: rgba(255,255,255,.7); margin-bottom: 20px; }
    .challenge-track {
      height: 3px; background: rgba(255,255,255,.2); border-radius: 99px;
      margin-bottom: 18px; overflow: hidden;
    }
    .challenge-fill { height: 100%; width: 0%; background: var(--white); border-radius: 99px; transition: width 1s ease; }
    .btn-challenge {
      width: 100%; padding: 12px; border-radius: 10px;
      background: var(--white); color: var(--teal-dark);
      border: none; cursor: pointer; font-family: var(--font-body);
      font-size: 13.5px; font-weight: 700;
      transition: background var(--t), transform var(--t);
    }
    .btn-challenge:hover { background: #e8f8f8; transform: translateY(-1px); }

    /* Achievements */
    .ach-card {
      background: var(--white); border: 1.5px solid var(--gray-200);
      border-radius: var(--radius); padding: 22px; box-shadow: var(--shadow-sm);
    }
    .ach-card > h3 { font-size: 15px; font-weight: 700; margin-bottom: 16px; }
    .stats-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 22px; }
    .stat-box {
      background: var(--off-white); border: 1.5px solid var(--gray-200);
      border-radius: 10px; padding: 14px 10px; text-align: center;
    }
    .stat-lbl {
      font-size: 9.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      color: var(--gray-400); margin-bottom: 6px;
    }
    .stat-num {
      font-family: var(--font-display); font-size: 30px; font-weight: 700;
      color: var(--dark); line-height: 1;
      display: flex; align-items: center; justify-content: center; gap: 3px;
    }
    .stat-sub { font-size: 11px; color: var(--gray-400); margin-top: 4px; }
    .weekly-lbl {
      font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      color: var(--gray-400); margin-bottom: 10px;
    }
    .bar-chart {
      display: flex; align-items: flex-end; gap: 5px; height: 80px; margin-bottom: 8px;
    }
    .bar-col { display: flex; flex-direction: column; align-items: center; gap: 4px; flex: 1; }
    .bar { width: 100%; border-radius: 4px 4px 0 0; background: var(--teal-mid); cursor: pointer; transition: background var(--t); }
    .bar:hover, .bar.hi { background: var(--teal); }
    .bar-d { font-size: 9.5px; color: var(--gray-400); font-weight: 500; }
    .time-row {
      display: flex; align-items: center; gap: 10px;
      background: var(--off-white); border-radius: 10px; padding: 11px 14px; margin-top: 4px;
    }
    .t-icon {
      width: 30px; height: 30px; border-radius: 8px; background: var(--teal);
      display: flex; align-items: center; justify-content: center; font-size: 14px; color: var(--white); flex-shrink: 0;
    }
    .t-val { font-size: 14px; font-weight: 700; }
    .t-sub { font-size: 11px; color: var(--gray-400); }

    /* Support tools */
    .support-card {
      background: var(--white); border: 1.5px solid var(--gray-200);
      border-radius: var(--radius); padding: 18px 20px; box-shadow: var(--shadow-sm);
    }
    .support-title {
      font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
      color: var(--gray-400); margin-bottom: 12px;
    }
    .support-item {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 10px; border-radius: 8px;
      text-decoration: none; color: var(--dark);
      font-size: 13.5px; font-weight: 600;
      transition: background var(--t), color var(--t);
    }
    .support-item:hover { background: var(--teal-pale); color: var(--teal); }
    .si-icon { font-size: 17px; }
    .s-div { height: 1px; background: var(--gray-100); margin: 2px 0; }

    /* ── FOOTER ── */
    footer { background: var(--dark); color: rgba(255,255,255,.38); padding: 34px 0; margin-top: 60px; }
    .footer-inner {
      max-width: 1160px; margin: 0 auto; padding: 0 28px;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;
    }
    .f-logo { font-family: var(--font-display); font-size: 18px; font-weight: 700; color: var(--white); }
    .f-sub { font-size: 12px; margin-top: 2px; }
    .f-links { display: flex; gap: 22px; list-style: none; flex-wrap: wrap; }
    .f-links a { color: rgba(255,255,255,.38); text-decoration: none; font-size: 12.5px; transition: color .2s; }
    .f-links a:hover { color: var(--white); }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero-banner     { animation: fadeUp .5s .04s ease both; }
    .active-section  { animation: fadeUp .5s .1s ease both; }
    .pathways        { animation: fadeUp .5s .18s ease both; }
    .right-col       { animation: fadeUp .5s .12s ease both; }

    /* ── RESPONSIVE ── */
    @media (max-width: 860px) {
      .main-grid { grid-template-columns: 1fr; }
      .hero-banner { padding: 36px 28px; }
    }
    @media (max-width: 600px) {
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
      .nav-links { display: none; }
    }
  </style>
</head>
<body>

<!-- ── NAVBAR ── -->
<nav>
  <div class="nav-inner">
    <a href="/" class="logo">Clarified Horizon</a>
    <ul class="nav-links">
      <li><a href="/">HOME</a></li>
      <li><a href="/learn" class="active">LEARN</a></li>
      <li><a href="/translate">TRANSLATE</a></li>
    </ul>
    <div class="nav-avatar" title="Sarah">S</div>
  </div>
</nav>

<!-- ── PAGE ── -->
<div class="wrap">

  <!-- Hero -->
  <div class="hero-banner">
    <!-- SVG wave decoration -->
    <div class="wave-bg">
      <svg viewBox="0 0 600 220" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,80 C80,20 160,140 240,80 C320,20 400,130 480,80 C540,44 580,90 600,70 L600,0 L0,0 Z" fill="rgba(255,255,255,0.055)"/>
        <path d="M0,140 C90,80 180,200 270,140 C360,80 450,190 600,140 L600,220 L0,220 Z" fill="rgba(255,255,255,0.045)"/>
        <path d="M0,180 C100,130 200,210 300,170 C400,130 500,200 600,160 L600,220 L0,220 Z" fill="rgba(255,255,255,0.03)"/>
        <circle cx="520" cy="50" r="60" fill="rgba(255,255,255,0.04)"/>
        <circle cx="460" cy="150" r="40" fill="rgba(255,255,255,0.035)"/>
      </svg>
    </div>
    <div class="hero-content">
      <div class="hero-eyebrow">Learning Dashboard</div>
      <h1>Welcome back, Sarah!<br>Continue your journey.</h1>
      <div class="hero-ctas">
        <a href="/lesson" class="btn btn-dark">Resume Lesson</a>
        <a href="#goals" class="btn btn-ghost-white">View Goals</a>
      </div>
    </div>
  </div>

  <!-- Grid -->
  <div class="main-grid">

    <!-- LEFT -->
    <div>

      <!-- Active Learning -->
      <div class="active-section">
        <div class="sec-hd">
          <h2>Active Learning</h2>
          <a href="learn.html" class="sec-link">View All History</a>
        </div>

        <a href="learn.html" class="active-card">
          <div class="active-thumb">
            <div class="play-circle">▶</div>
          </div>
          <div class="active-info">
            <div class="active-status">In Progress</div>
            <h3>Module 1: Basic Greetings</h3>
            <div class="lesson-sub">Lesson 2: How are you?</div>
            <div class="prog-row">
              <span class="prog-label">Course Progress</span>
              <div class="prog-track"><div class="prog-fill" style="width:65%"></div></div>
              <span class="prog-pct">65%</span>
            </div>
          </div>
        </a>
      </div>

      <!-- Pathways to Mastery -->
      <div class="pathways">
        <div class="sec-hd">
          <h2>Pathways to Mastery</h2>
        </div>

        <!-- Essential ASL -->
        <div class="group-label">Essential ASL</div>
        <div class="grid-2">

          <a href="learn.html" class="pathway-card">
            <div class="card-top">
              <div class="p-icon">🤟</div>
              <span class="p-meta">BEGINNER · 15M</span>
            </div>
            <h3>The Manual Alphabet</h3>
            <p>Master finger-spelling and the visual building blocks of ASL communication.</p>
          </a>

          <a href="learn.html" class="pathway-card">
            <div class="card-top">
              <div class="p-icon">👨‍👩‍👧</div>
              <span class="p-meta">BEGINNER · 25M</span>
            </div>
            <h3>Family &amp; Relations</h3>
            <p>Learn signs for family members, household terms, and personal relationships.</p>
          </a>

        </div>

        <!-- Specializations -->
        <div class="group-label">Specializations</div>
        <div class="grid-3">

          <a href="learn.html" class="pathway-card">
            <div class="p-icon" style="margin-bottom:12px">💼</div>
            <h3>Workplace Sign</h3>
            <p>Professional terminology and corporate etiquette in ASL.</p>
          </a>

          <a href="learn.html" class="pathway-card">
            <div class="p-icon" style="margin-bottom:12px">🌍</div>
            <h3>Cultural Nuances</h3>
            <p>Deaf culture, history, and linguistic variations.</p>
          </a>

          <a href="learn.html" class="pathway-card">
            <div class="p-icon" style="margin-bottom:12px">💬</div>
            <h3>Fluent Conversations</h3>
            <p>Connecting signs into fluid, natural sentences.</p>
          </a>

        </div>
      </div>
    </div><!-- /left -->

    <!-- RIGHT -->
    <div class="right-col">

      <!-- Daily Challenge -->
      <div class="daily-card">
        <div class="daily-eyebrow">⚡ Daily Challenge</div>
        <h3>5-Minute Fingerspelling Sprint</h3>
        <p>Test your speed and accuracy on 20 random words.</p>
        <div class="challenge-track"><div class="challenge-fill" id="cFill"></div></div>
        <button class="btn-challenge" onclick="startChallenge()">Start Challenge</button>
      </div>

      <!-- Achievements -->
      <div class="ach-card">
        <h3>Your Achievements</h3>

        <div class="stats-row">
          <div class="stat-box">
            <div class="stat-lbl">Current Streak</div>
            <div class="stat-num">12 <span>🔥</span></div>
            <div class="stat-sub">Days in a row</div>
          </div>
          <div class="stat-box">
            <div class="stat-lbl">Signs Learned</div>
            <div class="stat-num">432</div>
            <div class="stat-sub">+18 this week</div>
          </div>
        </div>

        <div class="weekly-lbl">Weekly Activity</div>
        <div class="bar-chart">
          <div class="bar-col"><div class="bar" style="height:44px"></div><div class="bar-d">MON</div></div>
          <div class="bar-col"><div class="bar" style="height:32px"></div><div class="bar-d">TUE</div></div>
          <div class="bar-col"><div class="bar" style="height:56px"></div><div class="bar-d">WED</div></div>
          <div class="bar-col"><div class="bar" style="height:26px"></div><div class="bar-d">THU</div></div>
          <div class="bar-col"><div class="bar hi" style="height:72px"></div><div class="bar-d">FRI</div></div>
          <div class="bar-col"><div class="bar" style="height:48px"></div><div class="bar-d">SAT</div></div>
          <div class="bar-col"><div class="bar" style="height:40px"></div><div class="bar-d">SUN</div></div>
        </div>

        <div class="time-row">
          <div class="t-icon">⏱</div>
          <div>
            <div class="t-val">3h 45m</div>
            <div class="t-sub">Time spent this week</div>
          </div>
        </div>
      </div>

      <!-- Support Tools -->
